# ===========================================
# Enterprise Dashboard - Environment Variables
# ===========================================
# 
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!
# ===========================================

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-generate-with-python-secrets

# Database
# SQLite for development:
DATABASE_URL=sqlite:///instance/dev.db
# PostgreSQL for production:
# DATABASE_URL=postgresql://user:password@localhost:5432/enterprise_dashboard

# LDAP Configuration
LDAP_SERVER=ldaps://ldap.company.local:636
LDAP_BASE_DN=dc=company,dc=local
LDAP_BIND_DN=cn=service_account,ou=service,dc=company,dc=local
LDAP_BIND_PASSWORD=your-ldap-service-account-password
LDAP_USER_SEARCH_BASE=ou=users
LDAP_USER_SEARCH_FILTER=(sAMAccountName={username})
LDAP_USE_SSL=True

# Session Settings
SESSION_LIFETIME_MINUTES=30

# Security Settings
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
